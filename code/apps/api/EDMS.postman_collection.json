{
  "info": {
    "name": "EDMS - Sprint 1",
    "description": "Demo luong dang nhap va goi API co xac thuc, dung voi seed data (npm run seed). Mat khau mac dinh: Password123!",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000" },
    { "key": "accessToken", "value": "" }
  ],
  "item": [
    {
      "name": "Health check",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "Dang nhap (admin seed)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const body = pm.response.json();",
              "if (body.success) pm.collectionVariables.set('accessToken', body.data.accessToken);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"emailOrPhone\": \"admin@edms.vn\",\n  \"password\": \"Password123!\"\n}"
        }
      }
    },
    {
      "name": "Dang nhap sai mat khau (401)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"emailOrPhone\": \"admin@edms.vn\",\n  \"password\": \"sai\"\n}"
        }
      }
    },
    {
      "name": "Goi API co xac thuc - GET /auth/me",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
        "url": "{{baseUrl}}/auth/me"
      }
    },
    {
      "name": "GET /auth/me khong co token (401)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/auth/me"
      }
    }
  ]
}
