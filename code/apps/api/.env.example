NODE_ENV=development
PORT=4044

# ---- CSDL ----
# Local (Docker, mac dinh - dung cho npm test):
MONGO_URI=mongodb://localhost:27018/edms?directConnection=true
# Cloud MongoDB Atlas (xem docs/HuongDanMongoAtlas.md). Thay <user>, <password>,
# <cluster>; giu "/edms" truoc dau "?" de dung database ten edms:
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/edms?retryWrites=true&w=majority&appName=edms

REDIS_URL=redis://localhost:6379

# ---- Cache doc du lieu ----
# Du lieu doc tu MongoDB duoc giu trong Redis toi da so giay nay (0 = tat cache)
CACHE_TTL_SECONDS=30
# redis (mac dinh) | memory (khong can Redis, chi dung khi chay 1 tien trinh)
CACHE_STORE=redis

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
