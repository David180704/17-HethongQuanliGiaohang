# Thuong KHONG can file .env - app tu tim dia chi API:
#   - Chay tren trinh duyet: cung hostname voi trang dang mo, cong 4044
#   - Chay tren dien thoai (Expo Go): IP LAN cua may dang chay "npm start", cong 4044
# Chi dat bien duoi day khi API o may khac hoac cong khac.
# EXPO_PUBLIC_API_URL=http://192.168.1.10:4044
# EXPO_PUBLIC_API_PORT=4044
