{
  "expo": {
    "name": "EDMS Nhân viên",
    "slug": "edms-staff",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "vn.edms17.nhanvien",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "EDMS Nhân viên dùng vị trí khi bạn mở ứng dụng để tự check-in tại điểm đã đăng ký và ghi tọa độ lúc lấy hàng, giao hàng."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "vn.edms17.nhanvien",
      "versionCode": 1,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "ACCESS_BACKGROUND_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "edmsnv",
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "EDMS Nhân viên dùng vị trí khi bạn mở ứng dụng để tự check-in tại điểm đã đăng ký và ghi tọa độ lúc lấy hàng, giao hàng.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ]
    ]
  }
}
